# Local default is Stripe TEST. Pages Production is live after Cap GO (sk_live_ / pk_live_).
# Never commit real keys. Copy to .dev.vars for `npm run dev`.

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional. If omitted, Checkout uses inline price_data (Personal $20 / Plus $40).
# STRIPE_PRICE_PERSONAL=price_...
# STRIPE_PRICE_PLUS=price_...

# Optional. Unset on Pages today — POST /api/webhook returns 503 until ops sets this.
# Do not invent a value.
# STRIPE_WEBHOOK_SECRET=whsec_...

# HMAC shared with Fly ACCOUNT_SYNC_SECRET. Website POSTs /accounts/sync
# and HMAC-GETs /accounts/dashboard (signature over the E.164 phone).
# Fly is the sole writer of users. Do not set NEON_DATABASE_URL here.
# ACCOUNT_SYNC_SECRET=replace_me
# CALL_AGENT_SYNC_URL=https://hidden-beacon-080.fly.dev/accounts/sync
# PUBLIC_BASE_URL=https://hidden-beacon-080.fly.dev

# Shared Treena iMessage bot (Linq sandbox DID; ride until ~Sep 18).
# Ops may swap later. Do not invent a different number.
PUBLIC_TREENA_IMESSAGE_E164=+12138653024
# LINQ_FROM_E164=+12138653024

# Google OAuth + Apple sign-in. Pages Production has these secrets.
# Apple Services ID defaults to com.usetreena.signin if APPLE_CLIENT_ID is unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=com.usetreena.signin
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# AUTH_SESSION_SECRET=
# AUTH_PUBLIC_ORIGIN=https://usetreena.com

# Optional no-charge dashboard prove grant. Comma-separated emails.
# Creates a Stripe Customer only — no subscription, no invoice.
# Unset to reverse. Do not invent pricing.
# COMPLIMENTARY_ENTITLEMENT_EMAILS=ops@usetreena.com

# Optional. npm run verify GET {origin}/ for live SHA + iMessage subhead.
# Unset in default CI.
# VERIFY_LIVE_ORIGIN=https://usetreena.com

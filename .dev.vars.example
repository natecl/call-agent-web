# Stripe TEST only. Never put sk_live_ or pk_live_ here.
# Copy to .dev.vars for `npm run dev`. Do not commit real values.

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional. If omitted, Checkout uses inline price_data (Personal $20 / Plus $40).
# STRIPE_PRICE_PERSONAL=price_...
# STRIPE_PRICE_PLUS=price_...

# Optional. Stripe TEST webhook signing secret for POST /api/webhook.
# STRIPE_WEBHOOK_SECRET=whsec_...

# HMAC shared with Fly ACCOUNT_SYNC_SECRET. Website POSTs /accounts/sync
# and HMAC-GETs /accounts/dashboard (signature over the E.164 phone).
# Fly is the sole writer of users. Do not set NEON_DATABASE_URL here.
# ACCOUNT_SYNC_SECRET=replace_me
# CALL_AGENT_SYNC_URL=https://hidden-beacon-080.fly.dev/accounts/sync
# PUBLIC_BASE_URL=https://hidden-beacon-080.fly.dev

# Optional. npm run verify GET {origin}/ for live SHA + iMessage subhead.
# Unset in default CI.
# VERIFY_LIVE_ORIGIN=https://usetreena.com
